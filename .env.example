# Local development settings (production: /etc/kago/kago.env, written by deploy/install.sh)
APP_NAME="Kago Analytics"
# Random string, at least 32 chars: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change_me_change_me_change_me_change_me
DATABASE_URL=postgresql+psycopg://kago:kago@127.0.0.1:5432/kago
# Base URL shown on the integrations page
PUBLIC_URL=http://127.0.0.1:8000
TIMEZONE=Europe/Moscow
# false only for plain-HTTP development
COOKIE_SECURE=false
STATS_CACHE_SECONDS=30
# Optional: create this admin on first start if there is no admin yet
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please
