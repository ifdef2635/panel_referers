# Local development settings (production: /etc/referral-panel/panel.env, written by deploy/install.sh)
APP_NAME="Referral Panel"
# Random string, at least 32 chars: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change_me_change_me_change_me_change_me
PANEL_DB_URL=sqlite:///./data/panel.db
TIMEZONE=Europe/Moscow
# false only for plain-HTTP development
COOKIE_SECURE=false
# Statistics cache, seconds
STATS_CACHE_SECONDS=60
# Remnashop PostgreSQL. In the stock docker-compose it is published on 127.0.0.1:5001.
REMNASHOP_DSN=postgresql://panel_ro:password@127.0.0.1:5001/remnashop
# Optional: create this admin on first start if there is no admin yet
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please
